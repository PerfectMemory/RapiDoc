{
  "name": "rapidoc-monorepo",
  "version": "10.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "docs"
  ],
  "type": "module",
  "scripts": {
    "dev": "npm run dev --workspace=docs",
    "stop": "npm run stop --workspace=docs",
    "build": "npm run build --workspace=@pm/rapidoc && npm run build --workspace=docs",
    "build:rapidoc": "npm run build --workspace=@pm/rapidoc",
    "build:rapidoc:dev": "npm run build:dev --workspace=@pm/rapidoc",
    "build:size": "npm run build:size --workspace=@pm/rapidoc",
    "build:docs": "npm run build --workspace=docs",
    "preview": "npm run preview --workspace=docs",
    "lint": "npm run lint --workspace=@pm/rapidoc",
    "format": "prettier --config .prettierrc --check './packages/**/*.{js,html,css}' './docs/src/**/*.{js,astro,html,css}'",
    "format-fix": "prettier --config .prettierrc --write './packages/**/*.{js,html,css}' './docs/src/**/*.{js,astro,html,css}'",
    "analyze": "npm run analyze --workspace=@pm/rapidoc",
    "publish:rapidoc": "npm publish --workspace=@pm/rapidoc",
    "test:perf": "node tests/perf/benchmark.js",
    "test:render": "node tests/perf/render-benchmark.js",
    "test:component": "node --test tests/component/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "postversion": "git push gitlab HEAD && git push gitlab v$npm_new_version"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.13.0",
    "lit-analyzer": "^2.0.3",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
